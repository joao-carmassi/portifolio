---
import Home from '@/layout/home.astro';
import { FALLBACK, langs, type Lang } from '@/i18n/langs';

// pt is served from the root, so only the prefixed languages get a route here
export const getStaticPaths = () =>
  langs.filter((lang) => lang !== FALLBACK).map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<Home lang={lang} />
