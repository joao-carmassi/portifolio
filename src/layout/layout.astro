---
import '@/styles/global.css';
import { Font } from 'astro:assets';
import { SEO, type Props as SEOProps } from 'astro-seo';
import { HTML_LANG, type Lang } from '@/i18n/langs';

interface Props extends SEOProps {
  lang: Lang;
}

const { lang, ...seo } = Astro.props as Props;
---

<html lang={HTML_LANG[lang]}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='generator' content={Astro.generator} />

    <link rel='icon' type='image/png' href='/favicon-96x96.png' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <link rel='shortcut icon' href='/favicon.ico' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
    <meta name='apple-mobile-web-app-title' content='Carmassi' />
    <link rel='manifest' href='/site.webmanifest' />
    <link rel='sitemap' href='/sitemap-index.xml' />

    <script is:inline>
      // runs before the first paint, so the page never flashes the wrong theme
      const stored =
        typeof localStorage !== 'undefined' && localStorage.getItem('theme');
      const theme = stored || 'light';
      document.documentElement.classList.toggle('dark', theme === 'dark');

      // whatever flips the class (the pull cord) gets persisted for free
      new MutationObserver(() => {
        localStorage.setItem(
          'theme',
          document.documentElement.classList.contains('dark') ? 'dark' : 'light',
        );
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['class'],
      });
    </script>
    <SEO {...seo} />
    <slot name='head' />

    <Font cssVariable='--font-raleway' preload />
    <Font cssVariable='--font-dm-serif' preload />
    <Font cssVariable='--font-geist-mono' />
  </head>
  <body>
    <slot />

    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      // same smooth scroll the old portfolio had through <ReactLenis root>
      const lenis = new Lenis({ lerp: 0.1, anchors: true });

      // ScrollTrigger reads the scroll position that lenis now writes, so it
      // has to hear about every move and run off the same clock
      lenis.on('scroll', ScrollTrigger.update);
      gsap.ticker.add((time) => lenis.raf(time * 1000));
      gsap.ticker.lagSmoothing(0);
    </script>
  </body>
</html>
