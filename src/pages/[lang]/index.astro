---
import Home from '@/layout/home.astro';
import { langs, type Lang } from '@/i18n/langs';

// all three languages are prefixed now, so this route builds every one of them
export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
---

<Home lang={lang} />
