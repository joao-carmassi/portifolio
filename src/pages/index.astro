---
import Layout from '@/layout/layout.astro';
import { GrainGradient } from '@paper-design/shaders-react';
---

<Layout>
  <main class='h-svh p-12'>
    <div
      class='bg-black text-white h-full w-full rounded-3xl p-12 relative overflow-auto'
    >
      <div class='relative z-10 flex flex-col justify-end gap-6 h-full'>
        <p>Focado em Next.js, Astro.js e Tailwind CSS</p>
        <h1 class='text-6xl font-semibold italic max-w-xs'>
          João Vitor Carmassi, desenvolvedor
        </h1>
        <p class='opacity-60 max-w-md font-semibold text-lg'>
          Criando experiências web perfeitas com tecnologias modernas e paixão
          por inovação.
        </p>
        <div class='space-x-3'>
          <button class='bg-white text-black px-3 py-2 rounded-full'>
            Sobre mim
          </button>
          <button
            class='bg-blue-600 text-secondary-foreground px-3 py-2 rounded-full'
          >
            Contato
          </button>
        </div>
      </div>

      <div class='absolute top-0 left-0 w-full h-full'>
        <GrainGradient
          client:load
          width={'100%'}
          height={'100%'}
          colors={['#7300ff', '#eba8ff', '#00bfff', '#2b00ff']}
          colorBack='#000000'
          softness={0.5}
          intensity={0.5}
          noise={0.25}
          shape='corners'
          speed={0.4}
          rotation={90}
        />
      </div>
    </div>
  </main>
</Layout>
